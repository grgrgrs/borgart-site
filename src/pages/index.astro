---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Home";
const description = "Borgart helps businesses turn scattered information, repetitive work, and disconnected tools into intelligent systems that support real work.";
---

<BaseLayout title={pageTitle} description={description}>

  <!-- ===== Hero ===== -->
  <section class="pt-10 pb-6 fade-in">
    <div class="text-[0.7rem] font-semibold uppercase tracking-widest mb-6" style="color: var(--brand-blue);">
      Borgart · From Signal to System
    </div>
    <h1 class="text-[2.1rem] font-light tracking-tight leading-[1.35] fade-in fade-in-d1" style="color: var(--text-primary); letter-spacing: -0.025em;">
      Borgart helps businesses turn scattered information, repetitive work, and disconnected tools into <strong class="font-semibold">intelligent systems that support real work</strong>.
    </h1>
    <p class="mt-6 text-[1.05rem] leading-relaxed max-w-[520px] fade-in fade-in-d2" style="color: var(--text-secondary);">
      We identify practical AI opportunities, design better workflows, and build systems that save time, reduce friction, and help work move forward — with people, not just automation, at the center.
    </p>
    <div class="gradient-line mt-6 fade-in fade-in-d3"></div>
  </section>

  <!-- ===== Class Announcement ===== -->
  <div class="pb-6">
    <div class="cta-block">
      <div class="text-[0.68rem] font-semibold uppercase tracking-widest mb-4 relative" style="color: var(--text-tertiary);">
        Upcoming class
      </div>
      <img
        src="/AISocialMediaMarketingBanner.png"
        alt="AI for Social Media Marketing — see 3 tools in one hour that will drive a real posting habit"
        style="width: 100%; margin: 0 auto 24px; display: block; border-radius: 12px; border: 1px solid var(--border-light);"
      />
      <div class="text-[0.68rem] font-semibold uppercase tracking-widest mb-3 relative" style="color: var(--text-tertiary);">
        AI for Social Media Marketing
      </div>
      <div class="text-[1.05rem] font-semibold mb-3 relative leading-snug" style="color: var(--text-primary);">
        A repeatable posting habit, in under an hour a week.
      </div>
      <p class="text-[0.88rem] leading-[1.7] relative mb-4" style="color: var(--text-secondary);">
        If your social media posting is inconsistent — or nonexistent — this hands-on hour shows a real way to fix it. No technical background needed. We demonstrate a complete workflow live, start to finish: brainstorming post ideas with AI grounded in your actual business, building a graphic, writing platform-ready captions, and scheduling to three social channels at once — about 45 to 60 minutes per posting session, instead of the three or four hours it usually takes by hand.
      </p>
      <div class="text-[0.8rem] font-semibold uppercase tracking-widest mb-2 relative" style="color: var(--text-tertiary);">
        What you'll learn
      </div>
      <ul class="text-[0.88rem] leading-[1.7] relative mb-5 space-y-1.5" style="color: var(--text-secondary);">
        <li>— Using an AI assistant to brainstorm and draft on-brand post ideas in minutes, not hours.</li>
        <li>— A simple design workflow for creating graphics without design skills.</li>
        <li>— Scheduling a week — or a month — of posts in one sitting, so you're never scrambling to post same-day.</li>
        <li>— The three tools that make this possible, and what they cost combined (about $50/month, tools included).</li>
      </ul>
      <p class="text-[0.88rem] leading-[1.7] relative mb-5" style="color: var(--text-secondary);">
        For small-business owners and solo marketers who want a consistent presence without hiring help or becoming a full-time social media manager. Bring a laptop if you'd like to follow along live.
      </p>
      <div class="text-[0.88rem] leading-[1.7] relative mb-5" style="color: var(--text-secondary);">
        Wednesday, September 2, 2026 | 3 PM ET | 1 hour<br />
        Register: igmanagementgroup.org/practical-ai-marketing
      </div>
      <div class="flex flex-wrap gap-3 relative">
        <a
          href="https://igmanagementgroup.org/practical-ai-marketing/"
          target="_blank"
          rel="noopener"
          class="px-6 py-3 rounded-md text-[0.88rem] font-medium text-center transition hover:opacity-80"
          style="background: var(--text-primary); color: var(--bg);"
        >
          Register for the class
        </a>
      </div>
    </div>
  </div>

  <!-- ===== Assessment Callout ===== -->
  <div class="pb-6 fade-in fade-in-d3">
    <div class="rounded-2xl px-7 py-6" style="border: 1px solid var(--border); background: rgba(255,255,255,0.6);">
      <div class="text-[0.68rem] font-semibold uppercase tracking-widest mb-3" style="color: var(--text-tertiary);">
        New: AI Opportunity Assessment for Small Businesses
      </div>
      <p class="text-[0.92rem] leading-[1.7] mb-4" style="color: var(--text-secondary);">
        There is now a focused way to explore where AI may help in your business. This assessment looks at workflows, documents, email, follow-ups, and operational information to identify practical opportunities and sensible next steps.
      </p>
      <a href="/ai-opportunity-assessment" class="text-link text-[0.88rem]">
        Learn about the assessment <span class="arrow">→</span>
      </a>
    </div>
  </div>

  <!-- ===== Is this you? ===== -->
  <section class="py-8 fade-in fade-in-d3" style="border-top: 1px solid var(--border-light);">
    <div class="text-[0.7rem] font-semibold uppercase tracking-widest mb-6" style="color: var(--text-tertiary);">
      Is this you?
    </div>
    <div class="space-y-6">
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Scattered client and project documents</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">You dig through folders, emails, and shared drives to remember what you did for a client or what you promised.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Leads and follow-ups slipping through the cracks</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">Quotes go out, but follow-ups don't always happen. Renewals and check-ins are easy to forget when things get busy.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Too much information, not enough time</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">You're flooded with emails, notes, and updates, and it's hard to tell what actually needs your attention.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Social media keeps getting shoved aside</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">You know you should have a steady presence, but posts always fall to the bottom of the list.</p>
      </div>
    </div>
  </section>

  <!-- ===== What we do ===== -->
  <section class="py-8" style="border-top: 1px solid var(--border-light);">
    <div class="text-[0.7rem] font-semibold uppercase tracking-widest mb-4" style="color: var(--text-tertiary);">
      What we do
    </div>
    <p class="text-[0.95rem] leading-[1.7] mb-6" style="color: var(--text-secondary);">
      Borgart works across four connected areas — starting from the signals already in your business and building toward systems your team can actually run. We add tools only where there's a clear, immediate benefit, and we keep people in control of the work.
    </p>
    <div class="space-y-6">
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">AI opportunity assessment</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">Understand where work is repetitive, delayed, manual, confusing, or falling through the cracks, and identify realistic opportunities for AI assistance.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Workflow and automation design</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">Connect information, tools, decisions, and recurring work into practical systems that fit how your business already operates.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">AI implementation and advisory</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">Support pilots, custom integrations, responsible adoption, and ongoing improvement — so changes stick and keep paying off.</p>
      </div>
      <div>
        <div class="text-[0.95rem] font-medium mb-1" style="color: var(--text-primary);">Products and experiments</div>
        <p class="text-[0.88rem] leading-relaxed" style="color: var(--text-secondary);">We build our own systems too, testing ideas that can grow into repeatable products for the businesses we work with.</p>
      </div>
    </div>
  </section>

  <!-- ===== BorgPost (in development) ===== -->
  <section class="py-8" style="border-top: 1px solid var(--border-light);">
    <div class="rounded-2xl px-7 py-6" style="border: 1px solid var(--border); background: var(--brand-soft-blue);">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-[0.68rem] font-semibold uppercase tracking-widest" style="color: var(--brand-blue);">BorgPost</span>
        <span class="text-[0.62rem] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full" style="background: var(--brand-white); color: var(--brand-slate); border: 1px solid var(--border);">In development</span>
      </div>
      <p class="text-[0.92rem] leading-[1.7]" style="color: var(--text-secondary);">
        BorgPost is an AI-assisted system being developed to help organizations plan, create, review, schedule, and maintain social-media content — without adding another cumbersome workflow. It's one of the products Borgart is building; if it's a fit for your business, we're happy to talk about early access.
      </p>
    </div>
  </section>

  <!-- ===== Page links ===== -->
  <section class="py-8" style="border-top: 1px solid var(--border-light);">
    <div class="space-y-1">
      <a href="/courses" class="list-item">
        <span class="text-[0.88rem]" style="color: var(--text-secondary);">Courses</span>
        <span class="text-[0.78rem]" style="color: var(--text-tertiary);">→</span>
      </a>
      <a href="/how-i-work" class="list-item">
        <span class="text-[0.88rem]" style="color: var(--text-secondary);">How we work</span>
        <span class="text-[0.78rem]" style="color: var(--text-tertiary);">→</span>
      </a>
      <a href="/about" class="list-item">
        <span class="text-[0.88rem]" style="color: var(--text-secondary);">About</span>
        <span class="text-[0.78rem]" style="color: var(--text-tertiary);">→</span>
      </a>
      <a href="/companion-ai" class="list-item">
        <span class="text-[0.88rem]" style="color: var(--text-secondary);">Companion AI</span>
        <span class="text-[0.78rem]" style="color: var(--text-tertiary);">→</span>
      </a>
      <a href="/contact" class="list-item" style="border-bottom: none;">
        <span class="text-[0.88rem]" style="color: var(--text-secondary);">Contact</span>
        <span class="text-[0.78rem]" style="color: var(--text-tertiary);">→</span>
      </a>
    </div>
  </section>

</BaseLayout>
